{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonikaSearch",
  "version": "0.3.0",
  "identifier": "com.monikasearch.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MonikaSearch",
        "width": 760,
        "height": 560,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["binaries/ctxhost.exe"]
  }
}
